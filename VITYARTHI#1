expense1 =[] #storing the expenses

while True:  # used to show the menu until the user chooses Exit
    # Display the menu
    print("Personal Expense Tracker")
    print("1.Add Expense")
    print("2.View Expenses")
    print("3.Total Expense")
    print("4.Exit")

    Choice = int(input("Enter your choice: "))  # taking input from the user to enter the choice

    if Choice == 1: # used to add expenses
        name = input("Enter expense name:") # input the name of the expense
        amount = float(input("Enter amount:")) # input the price of the expense

        expense1.append([name, amount])

        print("Expense added successfully")

    elif Choice == 2: # used to view all the expenses
        if len(expense1) == 0:
            print("No expenses found:")
        else:
            print("Your Expenses:")

            for i in range(len(expense1)):# visits all the expenses one by one
             name = expense1[i][0]
            amount = expense1[i][1]
            print(i + 1, name, "₹", amount) # Prints expense number, name, rupee symbol and amount
 
    elif Choice== 3:# used to total all the expenses
        total = 0  #initial value of total is zero
        for expense in expense1:
            total = total + expense[1] # Adding expense amount to the total

        print("Total Expense = ₹", total)

    elif Choice== 4:
        print("Thank you")
        break

    else:
        print("Invalid choice")